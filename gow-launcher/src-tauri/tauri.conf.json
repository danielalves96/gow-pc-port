{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "God Of War - PC Launcher",
  "version": "0.4.0-rc",
  "identifier": "com.PC.gow-launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && node scripts/stage-kit.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "God Of War (2005): PC Launcher",
        "width": 1440,
        "height": 1000,
        "minWidth": 1120,
        "minHeight": 720,
        "decorations": false,
        "center": true,
        "backgroundColor": "#1a110b"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERDRjM0M0ZCNEM1Nzk2QjAKUldTd2xsZE0rMFB6M0UxTjZ3MjM3b2ZOWDdxeHVlTUF5N1h4QUFtbmFaUXQyTUxDdC9lOERKZWQK",
      "endpoints": ["https://github.com/danielalves96/gow-pc-port/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "PC",
    "shortDescription": "Launcher and installer of the God of War (2005) native port",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "kit/": "kit/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "PortugueseBR"
        ],
        "displayLanguageSelector": true
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    }
  }
}
