// GOW-Port: resources of gow-2005.exe (the icon Explorer and the taskbar show, and the name Task Manager lists).
#include <winver.h>

1 ICON "gow.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,4,0,0
 PRODUCTVERSION 0,4,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "God of War (2005) native port"
            VALUE "FileVersion", "0.4.0"
            VALUE "ProductName", "God of War (2005) native port"
            VALUE "ProductVersion", "0.4.0"
            VALUE "InternalName", "gow-2005"
            VALUE "OriginalFilename", "gow-2005.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
